# ---------- Core ----------
NODE_ENV=production
HTTP_PORT=3000
HTTP_HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=*

# Public URL the API is served at through nginx (used in discovery responses/logs)
PUBLIC_BASE_URL=https://eplug.mn
# Every REST route is mounted under this path, locally and in production
API_BASE_PATH=/api

# ---------- Database (MongoDB) ----------
MONGODB_URI=mongodb://127.0.0.1:27017/csms
# If your MongoDB has auth enabled:
# MONGODB_URI=mongodb://user:pass@127.0.0.1:27017/csms?authSource=admin

# ---------- REST API auth ----------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
# Bootstrap admin created by `npm run seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
# Optional static key for machine-to-machine REST calls (header: x-api-key)
API_KEY=

# ---------- OCPP WebSocket ----------
# Charge points connect to  ws(s)://host:PORT/ocpp/{chargePointId}
OCPP_PATH_PREFIX=/ocpp
# 1 = HTTP Basic over plain ws, 2 = HTTP Basic over wss, 3 = mutual TLS client certificate
OCPP_SECURITY_PROFILE=1
# Reject charge points that are not pre-registered in the database
OCPP_REQUIRE_KNOWN_CHARGEPOINT=false
# Allow connections with no Authorization header (profile 1, development only)
OCPP_ALLOW_ANONYMOUS=true
# Seconds; returned in BootNotification.conf and used for offline detection
OCPP_HEARTBEAT_INTERVAL=300
# Milliseconds to wait for a CALLRESULT from the charge point
OCPP_CALL_TIMEOUT_MS=30000
# WebSocket ping interval; connection dropped after 2 missed pongs
OCPP_PING_INTERVAL_MS=30000
# Persist every inbound/outbound OCPP frame to the ocppmessagelogs collection
OCPP_LOG_MESSAGES=true
# Days to keep message logs (TTL index). 0 = keep forever
OCPP_LOG_RETENTION_DAYS=30

# ---------- TLS (security profiles 2 and 3) ----------
TLS_ENABLED=false
TLS_KEY_PATH=./certs/server.key
TLS_CERT_PATH=./certs/server.crt
# CA bundle used to verify charge point client certificates (profile 3)
TLS_CA_PATH=./certs/ca.crt

# ---------- Local CA used to sign charge point CSRs (SignCertificate.req) ----------
CSMS_CA_KEY_PATH=./certs/ca.key
CSMS_CA_CERT_PATH=./certs/ca.crt
CSMS_CERT_VALIDITY_DAYS=365
